# ─────────────────────────────────────────────────────────────────────────────
# Vórtex Pay — variáveis de ambiente
#
# Copie este arquivo para ".env" (cp .env.example .env) e preencha.
# Use ".env" mesmo (não ".env.local"): o Prisma, que cria as tabelas, só lê o ".env".
# NUNCA suba o ".env" pro GitHub (o .gitignore já impede).
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados (Postgres; o Supabase dá um de graça) ─────────────────────
# Supabase → Connect → ORMs → Prisma. Troque [YOUR-PASSWORD] pela senha do banco.
# Conexão do app: pooler "Transaction" (porta 6543), com ?pgbouncer=true no fim.
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SENHA-DO-BANCO@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexão pra criar/alterar tabelas (npx prisma db push): pooler "Session" (porta 5432).
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SENHA-DO-BANCO@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Login do painel ──────────────────────────────────────────────────────────
# Segredo que assina a sessão do painel. Obrigatório em produção.
# Gere com: openssl rand -base64 32
AUTH_SECRET=

# Primeiro administrador, criado por "npm run db:seed". Senha forte (10+ caracteres).
# Só é usado pelo seed, na sua máquina: não precisa ir pra Vercel.
ADMIN_EMAIL="voce@exemplo.com"
ADMIN_PASSWORD=

# ── Endereço público e marca ─────────────────────────────────────────────────
# Endereço do seu checkout, sem barra no fim (ex.: https://pagamentos.seu-dominio.com.br).
# Usado nos links de recuperação de senha e nos links de oferta da integração.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Nome que aparece no painel e nos e-mails (opcional; padrão "Vórtex Pay").
NEXT_PUBLIC_APP_NAME=

# ── Pagar.me (pagamentos) ────────────────────────────────────────────────────
# Painel da Pagar.me → Configurações → Chaves (ou Desenvolvimento → Chaves). Em teste: sk_test_… / pk_test_…
# Chave secreta (sk_…). Sem ela o checkout roda em "modo simulação" e não cobra.
PAGARME_API_KEY=
# Chave pública (pk_…). Transforma o cartão em token antes de cobrar. Obrigatória em produção.
PAGARME_PUBLIC_KEY=
# Segredo do webhook da Pagar.me (você inventa; vai no fim da URL do webhook: ?secret=…).
# Obrigatório em produção. Gere com: openssl rand -hex 24
PAGARME_WEBHOOK_SECRET=
# Alternativa ao de cima, se você configurar o webhook com usuário/senha (Basic Auth).
PAGARME_WEBHOOK_PASS=
# Nome na fatura do cartão (até 13 letras, sem acento). Opcional; padrão = nome do produto.
PAGARME_STATEMENT_DESCRIPTOR=

# ── E-mails (Resend) — opcional ──────────────────────────────────────────────
# Sem isso, o e-mail de "compra aprovada" e o "esqueci minha senha" não são enviados.
# resend.com → API Keys. O remetente precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Sua Empresa <contato@seu-dominio.com.br>"

# ── Reenvio automático dos webhooks (cron da Vercel) ─────────────────────────
# A Vercel manda esse segredo ao chamar /api/cron/webhooks. Obrigatório em produção.
# Gere com: openssl rand -hex 24
CRON_SECRET=

# ── Notificação de venda no celular (push) — opcional ────────────────────────
# Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do dono do app, no formato mailto:
VAPID_SUBJECT="mailto:contato@seu-dominio.com.br"

# ── Webhooks de saída — opcional ─────────────────────────────────────────────
# Valor do campo "store_id" nos webhooks que o sistema envia (padrão: default).
STORE_ID=

# ── API de integração (CRM ou outro sistema) — opcional ──────────────────────
# Liga as rotas /api/integracao/* (listar produtos, criar oferta, buscar pedido).
# Vazia = integração desligada. Precisa ter 40+ caracteres. Gere com: openssl rand -hex 32
INTEGRACAO_CHAVE=
# Menor preço (em centavos) que a integração pode criar. Ex.: 99700 = R$ 997,00. Padrão: 100.
INTEGRACAO_MINIMO_CENTAVOS=
# Domínio dos links de oferta, se for diferente do NEXT_PUBLIC_APP_URL (opcional).
INTEGRACAO_URL_PUBLICA=
